# =============================================================================
# NZ Legislation & Policy Workspace — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your credentials.
#   cp .env.example .env
#
# Shared credentials are propagated to subproject .env files by
# the env_sync_setup chore (see conductor/tracks/env_sync_setup_20260614/).
# =============================================================================

# --- Hugging Face ---
HF_TOKEN=replace_me
HF_REPO_ID=edithatogo/corpus-cases-medilegal-nz

# --- Git mirrors ---
GIT_MIRROR_URL=git@gitlab.com:edithatogo/corpus-cases-medilegal-nz.git
GIT_MIRROR_URL_GITLAB=git@gitlab.com:edithatogo/corpus-cases-medilegal-nz.git
GIT_MIRROR_URL_CODEBERG=git@codeberg.org:edithatogo/corpus-cases-medilegal-nz.git
GIT_MIRROR_SSH_PRIVATE_KEY=replace_me

# --- NZ Legislation API ---
NZ_LEGISLATION_API_KEY=replace_me

# --- Zenodo ---
ZENODO_ACCESS_TOKEN=replace_me
ZENODO_SANDBOX_ACCESS_TOKEN=replace_me
ZENODO_API_URL=https://zenodo.org/api
ZENODO_SANDBOX_API_URL=https://sandbox.zenodo.org/api
ARCHIVE_CREATORS_JSON=[{"name":"replace_me","affiliation":"replace_me"}]

# Legacy aliases for older local scripts
ZENODO_TOKEN=replace_me
ZENODO_SANDBOX_TOKEN=replace_me

# --- GitHub ---
GITHUB_TOKEN=replace_me

# --- AI / LLM Providers ---
DEEPSEEK_API_KEY=replace_me
GROQ_API_KEY=replace_me
OPENROUTER_API_KEY=replace_me
QWEN_API_KEY=replace_me

# --- Open Science Framework ---
OSF_TOKEN=replace_me
